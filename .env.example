# URL de conexión a la base de datos PostgreSQL (usada por Prisma)
DATABASE_URL="postgresql://usuario:password@localhost:5432/clinica_salud_integral"

# Puerto en el que escucha la API (opcional, default 3000)
PORT=3000

# Secreto usado para firmar y verificar los JWT (mínimo 10 caracteres)
JWT_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"
